{%- comment -%}
  Collection page with Shopify's native storefront filters (configured via the
  Search & Discovery app) plus a quick "roast level" chip row that uses the
  same filter URLs, and server-side sort/pagination.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
  <section class="collection-hero">
    <div class="page-width">
      <p class="eyebrow">{{ 'collections.count' | t: count: collection.products_count }}</p>
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-hero__text rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </section>

  <div class="page-width collection">
    <form class="collection-toolbar" data-collection-filters>
      {%- for filter in collection.filters -%}
        {%- if filter.type == 'list' -%}
          <details class="filter">
            <summary>
              {{ filter.label }}
              {%- if filter.active_values.size > 0 %} <span class="filter__count">{{ filter.active_values.size }}</span>{% endif -%}
            </summary>
            <div class="filter__panel">
              {%- for value in filter.values -%}
                <label class="filter__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                  >
                  {{ value.label }} <span>({{ value.count }})</span>
                </label>
              {%- endfor -%}
            </div>
          </details>
        {%- elsif filter.type == 'price_range' -%}
          <details class="filter">
            <summary>{{ filter.label }}</summary>
            <div class="filter__panel filter__panel--price">
              <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100 }}" placeholder="0" min="0" aria-label="Min price">
              <span>–</span>
              <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100 }}" placeholder="{{ filter.range_max | divided_by: 100 }}" min="0" aria-label="Max price">
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}

      <div class="collection-toolbar__sort">
        <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <select id="SortBy" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
      <noscript><button type="submit" class="button">{{ 'collections.filter' | t }}</button></noscript>
    </form>

    {%- assign active_count = 0 -%}
    {%- for filter in collection.filters -%}
      {%- assign active_count = active_count | plus: filter.active_values.size -%}
    {%- endfor -%}
    {%- if active_count > 0 -%}
      <div class="active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a class="chip chip--remove" href="{{ value.url_to_remove }}">{{ value.label }} ×</a>
          {%- endfor -%}
        {%- endfor -%}
        <a class="link-arrow" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear' | t }}</a>
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty-state">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {{ paginate | default_pagination: next: '→', previous: '←' }}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

<script>
  // Filters and sort auto-submit; the form works without JS via the noscript button.
  document.querySelector('[data-collection-filters]')?.addEventListener('change', (e) => e.currentTarget.requestSubmit());
</script>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ]
}
{% endschema %}
