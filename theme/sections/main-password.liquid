{%- comment -%}
  Shown while the store is password-protected (always true on dev stores).
  Branded "opening soon" page with newsletter signup + staff password form.
{%- endcomment -%}
<section class="password-page">
  <div class="password-page__card">
    <p class="logo">
      <span class="logo__mark" aria-hidden="true">{% render 'icon', name: 'bean' %}</span>
      <span class="logo__text">{{ shop.name }}</span>
    </p>
    <p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {%- else -%}
      <div class="password-page__message rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter password-page__newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
      <input id="PasswordNewsletter" type="email" name="contact[email]" placeholder="you@example.com" required>
      <button type="submit" class="button button--ember">Notify me</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <div class="password-page__staff">
      <p>Have the store password?</p>
      {%- form 'storefront_password', class: 'password-page__form' -%}
        {%- if form.errors -%}
          <p class="form-error" role="alert">That password didn’t work. Try again.</p>
        {%- endif -%}
        <label class="visually-hidden" for="StorePassword">Password</label>
        <input id="StorePassword" type="password" name="password" placeholder="Store password" autocomplete="current-password" required>
        <button type="submit" class="button button--ghost">Enter</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "First roast drops soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The roaster is warming up." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We’re dialing in our first small batches. Leave your email and we’ll tell you the moment the doors open.</p>"
    }
  ]
}
{% endschema %}
