{%- comment -%}
  Hero whose background "roasts" as you scroll: the gradient moves from
  green-bean pale to dark roast, and a live label tracks the roast stage.
  JS only sets one CSS variable (--roast-progress); the rest is CSS.
{%- endcomment -%}
<section class="hero-roast" data-hero-roast style="--roast-progress: 0">
  <div class="hero-roast__bg" aria-hidden="true"></div>
  <div class="page-width hero-roast__inner">
    <div class="hero-roast__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero-roast__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero-roast__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero-roast__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="button button--ember" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{- section.settings.primary_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--ghost" href="{{ section.settings.secondary_link | default: '#brew-quiz' }}">
            {{- section.settings.secondary_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-roast__gauge" aria-hidden="true">
      <div class="roast-dial">
        <span class="roast-dial__bean">{% render 'icon', name: 'bean' %}</span>
        <ol class="roast-dial__stages">
          <li>Green</li>
          <li>First crack</li>
          <li>City</li>
          <li>Full city</li>
          <li>Second crack</li>
        </ol>
        <p class="roast-dial__live">Roasting: <strong data-roast-stage>Green</strong></p>
      </div>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag: class: 'hero-roast__image', loading: 'eager', widths: '450, 700, 900', sizes: '(min-width: 990px) 40vw, 90vw'
        }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Roast hero",
  "tag": "div",
  "class": "section-hero-roast",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-batch · Roasted Tuesdays" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coffee that tastes like where it came from." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Direct-trade beans, roasted in 12 kg batches and shipped within 48 hours. Scroll to watch a roast happen.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop coffee" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Find my coffee" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Roast hero" }]
}
{% endschema %}
