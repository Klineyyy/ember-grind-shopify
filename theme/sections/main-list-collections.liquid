<section class="page-width section">
  <h1>{{ section.settings.heading }}</h1>
  <div class="collection-list">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        <a class="collection-tile" href="{{ collection.url }}">
          <span class="eyebrow">{{ 'collections.count' | t: count: collection.products_count }}</span>
          <span class="collection-tile__title">{{ collection.title }}</span>
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }]
}
{% endschema %}
