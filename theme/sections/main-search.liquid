<section class="page-width search-page">
  <h1>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="SearchInput">{{ 'search.title' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <button type="submit" class="button button--ember">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      {%- if search.results_count > 0 -%}
        <p class="search-page__count">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- else -%}
        <p class="empty-state">{{ 'search.none' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search results" }
{% endschema %}
