{
  "name": "restock-radar-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/client --ignore ./dist src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "demo:packshots": "tsx scripts/render-packshots.ts"
  },
  "dependencies": {
    "@shopify/shopify-api": "^15.0.0",
    "@shopify/shopify-app-express": "^8.0.2",
    "@shopify/shopify-app-session-storage": "^7.0.0",
    "@shopify/shopify-app-session-storage-drizzle": "^6.0.0",
    "@tanstack/react-query": "^5.104.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "^1.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "preact": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
